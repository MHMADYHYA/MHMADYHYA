# ─────────────────────────────────────────────────────────────
#  انسخ هاد الملف باسم .env وعبّي القيم. ملف .env ما بينرفع على Git.
#  الشرح خطوة خطوة: docs/SUPABASE_SETUP.md
# ─────────────────────────────────────────────────────────────

# رابط مشروع Supabase (Project Settings → API → Project URL)
# مثال: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# المفتاح العام (anon public key / Publishable key)
# هاد المفتاح مسموح يكون بالواجهة. ما تحط هون service_role أو secret key أبداً.
VITE_SUPABASE_ANON_KEY=

# رابط التطبيق اللي بيوصل للزبائن (بينبني منه رابط الرد بالرسائل)
# محلياً خليه هيك. بعد الرفع على Cloudflare Pages بنغيّره للرابط الحقيقي.
VITE_PUBLIC_BASE_URL=http://localhost:5173

# المفتاح العام للتنبيهات على التلفون (Web Push / VAPID). بتولّده بأمر: npm run vapid
# المفتاح الخاص ما بينحط هون أبداً، بينحط بأسرار Supabase (docs/NOTIFICATIONS_SETUP.md)
VITE_VAPID_PUBLIC_KEY=
